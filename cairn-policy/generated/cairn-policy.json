  "report_contract": {
    "sections": [
      "Findings",
      "Required Fixes",
      "OpenSpec Check",
      "Gaps",
      "Next Steps"
    ],
    "tagged_findings_required_fields": [
      "class",
      "scope",
      "route",
      "promoted"
    ],
    "verdicts": [
      "PASS",
      "WARN",
      "FAIL"
    ]
  },
  "schemas": [
    {
      "artifacts": [
        {
          "generates": "proposal.md",
          "id": "proposal",
          "requires": []
        },
        {
          "generates": "specs/**/*.md",
          "id": "specs",
          "requires": [
            "proposal"
          ]
        },
        {
          "generates": "design.md",
          "id": "design",
          "requires": [
            "proposal"
          ]
        },
        {
          "generates": "tasks.md",
          "id": "tasks",
          "requires": [
            "specs",
            "design"
          ]
        }
      ],
      "description": "OpenSpec proposal/spec/design/tasks lifecycle",
      "id": "spec-driven"
    }
  ],
  "sync_archive_policy": {
    "archive_date_prefix": true,
    "default_archive_dir": "cairn/archive",
    "require_all_tasks_done": true
  },
  "task_marker_policy": {
    "enabled": true,
    "ignore_archives": true,
    "markers": [
      {
        "id": "parallel",
        "kind": "literal",
        "token": "[parallel]"
      },
      {
        "id": "serial",
        "kind": "literal",
        "token": "[serial]"
      },
      {
        "id": "depends",
        "kind": "depends-prefix",
        "token": "[depends:<task-or-id>]"
      }
    ],
    "stages": [
      "tasks"
    ],
    "strictness": "strict"
  },
  "version": 1

    "entropy_inventory": [
      {
        "class": "environment",
        "description": "Archive date environment overrides are replay-relevant clock/date entropy and are rejected during replay when present; values are never disclosed.",
        "handling": "reject",
        "id": "archive_date_env",
        "receipt_field": "nondeterminism_failures",
        "source": "CAIRN_ARCHIVE_DATE,IRONSPEC_ARCHIVE_DATE"
      },
      {
        "class": "clock_date",
        "description": "Archive dry-run replay assumes the deterministic default archive date unless an explicit rejected override is present.",
        "handling": "normalize",
        "id": "clock_date_default",
        "receipt_field": "entropy_assumptions",
        "source": "archive default date"
      },
      {
        "class": "locale_timezone",
        "description": "Replay receipts use canonical JSON, sorted keys, and policy-owned string data rather than locale-sensitive formatting.",
        "handling": "normalize",
        "id": "locale_timezone",
        "receipt_field": "entropy_assumptions",
        "source": "process locale and timezone"
      },
      {
        "class": "filesystem_path",
        "description": "Root-specific checkout and temporary prefixes are normalized before portable hash computation; display paths remain operator-facing.",
        "handling": "normalize",
        "id": "cwd_root_paths",
        "receipt_field": "root,normalization_rules",
        "source": "current working directory and replay root"
      },
      {
        "class": "filesystem_metadata",
        "description": "Replay manifests sort root-relative paths and hash file contents; volatile host metadata is not part of portable evidence.",
        "handling": "normalize",
        "id": "filesystem_order",
        "receipt_field": "mutability_observations",
        "source": "directory iteration order and file metadata"
      },
      {
        "class": "toolchain",
        "description": "Replay discloses that toolchain identity is represented by policy and receipt hashes rather than raw host paths.",
        "handling": "disclose",
        "id": "external_command_versions",
        "receipt_field": "entropy_assumptions",
        "source": "cairn binary, Nix/devshell, and external checker versions"
      },
      {
        "class": "build_context",
        "description": "Replay assumes a reviewed Nix-built Cairn surface and does not capture machine-specific store paths in portable evidence.",
        "handling": "disclose",
        "id": "nix_build_context",
        "receipt_field": "entropy_assumptions",
        "source": "Nix flake/devshell context"
      }
    ],
    "environment_attestation": [
      {
        "class": "binary_identity",
        "description": "Replay discloses the Cairn package name and version compiled into the binary, not the host binary path.",
        "handling": "disclose",
        "id": "cairn_package_version",
        "receipt_field": "environment_attestation.cairn_version",
        "source": "CARGO_PKG_VERSION"
      },
      {
        "class": "policy_identity",
        "description": "Replay binds the generated policy content by BLAKE3 hash.",
        "handling": "hash",
        "id": "generated_policy_hash",
        "receipt_field": "environment_attestation.generated_policy_hash",
        "source": "cairn-policy/generated/cairn-policy.json"
      },
      {
        "class": "entropy_policy_identity",
        "description": "Replay binds the reviewed entropy inventory by BLAKE3 hash.",
        "handling": "hash",
        "id": "entropy_policy_hash",
        "receipt_field": "environment_attestation.entropy_policy_hash",
        "source": "determinism_replay_policy.entropy_inventory"
      },
      {
        "class": "selection_identity",
        "description": "Replay discloses the selected case and group ids used to produce evidence.",
        "handling": "disclose",
        "id": "replay_selection",
        "receipt_field": "environment_attestation.selected_cases,environment_attestation.selected_groups",
        "source": "--case/--group/default replay selection"
      },
      {
        "class": "attestation_policy_identity",
        "description": "Replay binds this reviewed environment attestation policy by BLAKE3 hash.",
        "handling": "hash",
        "id": "attestation_policy",
        "receipt_field": "environment_attestation.attestation_policy_hash",
        "source": "determinism_replay_policy.environment_attestation"
      },
      {
        "class": "build_context",
        "description": "Replay discloses reviewed build/toolchain context as policy facts and avoids machine-specific store paths.",
        "handling": "disclose",
        "id": "toolchain_build_context",
        "receipt_field": "environment_attestation.policy_facts",
        "source": "Nix/devshell/toolchain context"
      }
    ],
    "groups": [

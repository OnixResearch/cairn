{
  "exemption_marker_policy": {
    "date_fields": [
      "until"
    ],
    "optional_fields": [
      "scope"
    ],
    "required_fields": [
      "reason",
      "owner",
      "until"
    ]
  },
  "exemptions": [],
  "finding_defaults": {
    "class": "omission",
    "promoted": "no",
    "route": "auto-fix",
    "scope": "tasks",
    "severity": "high"
  },
  "gate_policy": {
    "finding": {
      "class": "omission",
      "promoted": "no",
      "route": "auto-fix",
      "scope": "tasks",
      "severity": "high"
    },
    "ignore_archives": true,
    "stages": [
      "proposal",
      "design",
      "tasks"
    ]
  },
  "lifecycle_stages": [
    "proposal",
    "design",
    "tasks",
    "implementation",
    "archive"
  ],
  "mutation_policy": {
    "archive": {
      "require_passing_gate": true
    },
    "migrate": {
      "require_manifest": true
    },
    "sync": {
      "require_passing_gate": true
    }
  },
  "name": "cairn-default",
  "receipt_hash_policy": {
    "algorithm": "BLAKE3",
    "canonicalization": "serde_json_compact_sorted_keys",
    "required": true
  },
  "receipt_schemas": [
    {
      "action_keys": [],
      "case_keys": [],
      "command": "gate",
      "hash_fields": [
        "input_hash",
        "policy_hash",
        "receipt_hash"
      ],
      "issue_keys": [
        "message",
        "promoted",
        "scope"
      ],
      "mismatch_keys": [],
      "top_level_keys": [
        "change",
        "input_hash",
        "issues",
        "layout",
        "policy",
        "policy_hash",
        "receipt_hash",
        "stage",
        "valid",
        "verdict"
      ]
    },

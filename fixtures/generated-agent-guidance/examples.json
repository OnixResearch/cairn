      "command_id": "workflow-status",
      "invocation": "cairn workflow status <change> --root PATH",
      "expect": "accepted"
    },
    {
      "id": "readiness-doctor",
      "kind": "command",
      "command_id": "doctor",
      "invocation": "cairn doctor --root PATH",
      "expect": "accepted"
    },
    {
      "id": "readiness-validate",
      "kind": "command",
      "command_id": "validate",
      "invocation": "cairn validate --root PATH",
      "expect": "accepted"
    },
    {
      "id": "stage-instructions",
      "kind": "command",
      "command_id": "workflow-instructions",
      "invocation": "cairn workflow instructions <artifact> --change <change> --root PATH",
      "expect": "accepted"
    },
    {
      "id": "profile-selection",
